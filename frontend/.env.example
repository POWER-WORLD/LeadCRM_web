# ==============================================================================
# LeadCRM Frontend Environment Configuration (Vercel & Local Dev)
# ==============================================================================
# Copy this file to '.env.local' for local development.
# On Vercel: Set NEXT_PUBLIC_API_URL in Project Settings -> Environment Variables.
# NEVER commit private credentials or secrets into public client-side variables.
# ==============================================================================

# Backend REST API Base URL (Render Web Service in production, localhost in development)
# Local Development: http://localhost:5000/api
# Production (Render): https://leadcrm-backend101.onrender.com/api
NEXT_PUBLIC_API_URL=https://leadcrm-backend101.onrender.com/api
