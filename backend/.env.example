# ==============================================================================
# LeadCRM Backend Environment Configuration (Render Web Service & Local Dev)
# ==============================================================================
# Copy this file to '.env' and populate with your environment-specific credentials.
# In Render Dashboard: Set these in "Environment Variables" for your Web Service.
# NEVER commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# Server execution port (Render sets this dynamically, defaults to 5000 locally)
PORT=5000

# Application environment ('development' locally | 'production' on Render)
NODE_ENV=development

# MongoDB Atlas connection string URI (Supports MONGODB_URI or MONGO_URI)
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<database-name>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/leadcrm?retryWrites=true&w=majority

# Primary Frontend client origin hosted on Vercel for CORS whitelisting
FRONTEND_URL=https://lead-crm-web.vercel.app

# Additional comma-separated allowed CORS origins (Frontend Vercel + Local dev)
ALLOWED_ORIGINS=https://lead-crm-web.vercel.app,http://localhost:3000,http://127.0.0.1:3000

# Production Backend URL hosted on Render
BACKEND_URL=https://lead-crm-web-backend.onrender.com

# JSON Web Token secret key (min 32 random characters for cryptographic security)
JWT_SECRET=leadcrm_secure_jwt_token_secret_replace_in_production_min_32_chars

# JWT token expiration duration (e.g. 7d, 24h)
JWT_EXPIRES_IN=7d
