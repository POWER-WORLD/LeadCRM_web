{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "noUnusedLocals": true
  },
  "include": [
    "start.ts",
    "api/**/*",
    "controllers/**/*",
    "db/**/*",
    "middleware/**/*",
    "models/**/*",
    "routes/**/*",
    "types/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
