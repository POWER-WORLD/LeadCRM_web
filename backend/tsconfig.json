{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "moduleResolution": "node16",
  },
  "include": ["start.ts", "controllers/**/*", "db/**/*", "middleware/**/*", "models/**/*", "routes/**/*", "types/**/*"],
  "exclude": ["node_modules", "dist", "*.js"]
}
